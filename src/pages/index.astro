---
import { Picture, getImage } from 'astro:assets';
import { CATALOG, INSTAGRAM, MENSAJES, WHATSAPP_VISIBLE, waLink } from '../data/site';

import sillonesJardin from '../assets/img/ig/sillones-jardin.jpg';
import sillaTapizada from '../assets/img/ig/silla-tapizada.jpg';
import esterilla from '../assets/img/ig/esterilla.jpg';
import logo from '../assets/img/ig/logo.jpg';
import sillaAntes from '../assets/img/restauraciones/silla-antes.jpg';
import sillaDespues from '../assets/img/restauraciones/silla-despues.jpg';
import variedad1 from '../assets/img/catalogo/variedad-1.jpg';
import paneraTejidos from '../assets/img/catalogo/panera-tejidos.jpg';

// Fotos del catálogo: canasta-01.jpg … canasta-NN.jpg
const fotosCatalogo = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/catalogo/canasta-*.jpg',
  { eager: true },
);
const fotoDe = (n: number) =>
  fotosCatalogo[`../assets/img/catalogo/canasta-${String(n).padStart(2, '0')}.jpg`].default;

// Versión grande (para el lightbox) de cada canasta
const catalogo = await Promise.all(
  CATALOG.map(async (m) => {
    const foto = fotoDe(m.n);
    const grande = await getImage({ src: foto, width: 1200, format: 'webp' });
    return { ...m, foto, grande: grande.src };
  }),
);
const canastaHero = fotoDe(1);

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const url = new URL(base, Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'TacuarArte',
  description:
    'Taller artesanal de restauración integral de muebles: carpintería, herrería, tapicería, esterillado francés y americano, enjuncado y cestería en mimbre a medida.',
  url,
  image: `${url}img/ig/sillones-jardin.jpg`,
  logo: `${url}img/ig/logo.jpg`,
  telephone: '+5493794637135',
  founder: { '@type': 'Person', name: 'Carlos Roubineau' },
  address: { '@type': 'PostalAddress', addressLocality: 'Corrientes', addressRegion: 'Corrientes', addressCountry: 'AR' },
  areaServed: { '@type': 'City', name: 'Corrientes', containedInPlace: { '@type': 'State', name: 'Corrientes' } },
  sameAs: [INSTAGRAM],
  makesOffer: [
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Restauración integral de muebles' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Esterillado con esterilla de ratán, estilo francés y americano' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Enjuncado con papel kraft, PVC y otros materiales sintéticos' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Tapizados' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Carpintería restaurativa' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Herrería' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Product', name: 'Cestería en mimbre artesanal' } },
  ],
};

const formatos = ['avif', 'webp'] as const;
---
<!DOCTYPE html>
<html lang="es-AR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restauración integral de muebles en Corrientes | TacuarArte</title>
  <meta name="description" content="Taller de Carlos Roubineau en Corrientes: restauración de muebles, esterillado de sillas, enjuncado, tapicería, herrería y cestería en mimbre a medida.">
  <meta name="theme-color" content="#3a2416">
  <!-- Solo scripts propios; fuentes desde Google Fonts. El JSON-LD no se ejecuta, CSP no lo bloquea. -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <link rel="canonical" href={url}>
  <link rel="icon" href={`${base}img/favicon.svg`} type="image/svg+xml">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="TacuarArte">
  <meta property="og:url" content={url}>
  <meta property="og:title" content="TacuarArte: restauración integral de muebles en Corrientes">
  <meta property="og:description" content="Restauración de sillas y muebles, esterillado francés y americano, enjuncado, tapicería y canastos de mimbre artesanales. Corrientes Capital.">
  <meta property="og:image" content={`${url}img/ig/sillones-jardin.jpg`}>
  <meta property="og:image:width" content="630">
  <meta property="og:image:height" content="640">
  <meta property="og:image:alt" content="Dos sillones de caña restaurados en un jardín">
  <meta property="og:locale" content="es_AR">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href={`${base}css/styles.css?v=3`}>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</head>
<body>

  <a class="skip" href="#main">Saltar al contenido</a>

  <!-- ============ NAV ============ -->
  <header class="nav" id="top">
    <div class="nav__inner wrap">
      <a href="#top" class="brand" aria-label="TacuarArte, inicio">
        <span class="brand__mark">C<i></i>R</span>
        <span class="brand__name">TacuarArte</span>
      </a>

      <nav class="nav__links" id="menu" aria-label="Secciones">
        <a href="#servicios">Servicios</a>
        <a href="#restauraciones">Restauraciones</a>
        <a href="#cesteria">Cestería</a>
        <a href="#como-trabajamos">Cómo trabajamos</a>
        <a href="#contacto">Contacto</a>
      </nav>

      <a class="btn btn--wa btn--sm nav__wa" href={waLink(MENSAJES.consulta)} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
        <span>WhatsApp</span>
      </a>

      <button class="nav__burger" id="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu">
        <span></span><span></span>
      </button>
    </div>
  </header>

  <main id="main">

    <!-- ============ HERO ============ -->
    <section class="hero wrap">
      <div class="hero__text">
        <p class="eyebrow">Restauración integral de muebles · Corrientes</p>
        <h1>Muebles con historia, <em>restaurados artesanalmente a mano.</em></h1>
        <p class="hero__lead">
          Devolvemos a la vida ese mueble de familia: sillas, sillones, mesas,
          cristaleros y cómodas. Hacemos carpintería, herrería, tapicería, esterillado
          y enjuncado, y trabajos en mimbre a medida y a pedido.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--wa" href={waLink(MENSAJES.presupuesto)} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
            Pedir presupuesto
          </a>
          <a class="btn btn--ghost" href="#restauraciones">Ver trabajos</a>
        </div>
        <p class="hero__note">Mandá fotos del mueble por WhatsApp y te respondemos con el presupuesto.</p>
      </div>

      <div class="hero__media">
        <figure class="hero__main">
          <Picture src={sillonesJardin} formats={formatos} widths={[400, 630]} sizes="(max-width: 700px) 90vw, 520px" alt="Dos sillones de caña restaurados, apoyados sobre el pasto" loading="eager" fetchpriority="high" />
        </figure>
        <figure class="hero__inset">
          <Picture src={canastaHero} formats={formatos} widths={[400, 800]} sizes="(max-width: 700px) 40vw, 260px" alt="Canasta de mimbre con tapa y manija" />
        </figure>
        <span class="hero__stamp" aria-hidden="true">100%<br>hecho a mano</span>
      </div>
    </section>

    <!-- ============ OFICIOS STRIP ============ -->
    <div class="strip" aria-hidden="true">
      <div class="strip__track">
        <span>Madera</span><span>Metal</span><span>Tacuara</span><span>Mimbre</span><span>Esterilla</span><span>Junco</span><span>Tapicería</span>
        <span>Madera</span><span>Metal</span><span>Tacuara</span><span>Mimbre</span><span>Esterilla</span><span>Junco</span><span>Tapicería</span>
      </div>
    </div>

    <!-- ============ SERVICIOS ============ -->
    <section class="section wrap" id="servicios">
      <header class="section__head">
        <p class="eyebrow">Lo que hacemos</p>
        <h2>Restauración, esterillado y tapicería: <em>oficios de taller, a mano</em></h2>
        <p class="section__intro">Trabajamos sobre los muebles que ya tenés, en Corrientes Capital: refacción y arreglo de sillas, cambio de esterilla, tapizado de sillas y sillones. Cada trabajo se presupuesta según el mueble y lo que necesita.</p>
      </header>

      <ul class="services">
        <li class="service">
          <svg class="service__icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M14 6v20M34 6v20M12 26h24v6H12zM14 32v10M34 32v10M14 12c6 3 14 3 20 0"/></svg>
          <h3>Restauración de muebles</h3>
          <p>Sillas, sillones, mesas, cristaleros, cómodas y muebles antiguos: reparación de estructura, encolado, lijado y acabado final.</p>
        </li>
        <li class="service">
          <svg class="service__icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M8 8h32v32H8z"/><path d="M8 18h32M8 30h32M18 8v32M30 8v32M8 8l32 32M40 8 8 40"/></svg>
          <h3>Esterillado francés y americano</h3>
          <p>Asientos y respaldos de esterilla tejida o implantada, en material <strong>natural</strong> o <strong>sintético</strong>. Trabajamos con <strong>esterilla de ratán importada</strong>, estilo francés y americano.</p>
        </li>
        <li class="service">
          <svg class="service__icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M8 10h32v28H8z"/><path d="M8 10l16 14L40 10M8 38l16-14 16 14"/></svg>
          <h3>Enjuncado</h3>
          <p>Enjuncado de muebles con materiales sintéticos: <strong>papel kraft</strong>, <strong>PVC</strong> y otros.</p>
        </li>
        <li class="service">
          <svg class="service__icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M10 22c0-6 6-10 14-10s14 4 14 10v6H10z"/><path d="M8 28h32v4H8zM12 32v8M36 32v8"/></svg>
          <h3>Tapizados</h3>
          <p>Retapizado de sillas, banquetas y sillones, con cambio de goma espuma y telas a elección.</p>
        </li>
        <li class="service">
          <svg class="service__icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M8 36 28 16M24 12l8-6 10 10-6 8z"/><path d="M6 42h14"/></svg>
          <h3>Carpintería y herrería</h3>
          <p>Trabajos de carpintería restaurativa, herrería y otros: reparaciones y piezas de reemplazo para muebles existentes.</p>
        </li>
        <li class="service">
          <svg class="service__icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M10 20h28l-3 20H13z"/><path d="M16 20c0-8 16-8 16 0M11 27h26M12 33h24"/></svg>
          <h3>Artesanías</h3>
          <p>Piezas en <strong>madera, metal, tacuara y mimbre</strong>: canastos, paneras, decoración y más.</p>
        </li>
      </ul>
    </section>

    <!-- ============ RESTAURACIONES ============ -->
    <section class="section section--dark" id="restauraciones">
      <div class="wrap">
        <header class="section__head">
          <p class="eyebrow">Antes y después · Restauración de sillas y muebles</p>
          <h2>Lo que parecía perdido, <em>vuelve a tener vida</em></h2>
        </header>

        <div class="ba">
          <figure class="ba__item">
            <span class="ba__tag">Antes</span>
            <Picture src={sillaAntes} formats={formatos} alt="Silla de madera curvada sin asiento, con la esterilla rota" />
          </figure>
          <span class="ba__arrow" aria-hidden="true">→</span>
          <figure class="ba__item">
            <span class="ba__tag ba__tag--after">Después</span>
            <Picture src={sillaDespues} formats={formatos} alt="La misma silla restaurada, con asiento nuevo de esterilla de ratán" />
          </figure>
          <div class="ba__text">
            <h3>Silla de madera curvada</h3>
            <p>Llegó sin asiento y con la madera castigada por los años. Se lavó y ajustó la estructura, y se le tejió un asiento nuevo con <strong>esterilla de ratán</strong> (esterillado estilo francés).</p>
            <a class="link" href={waLink(MENSAJES.silla)} target="_blank" rel="noopener">¿Tenés una parecida? Consultanos →</a>
          </div>
        </div>

        <div class="works">
          <figure class="work work--tall">
            <Picture src={sillaTapizada} formats={formatos} alt="Silla de madera curvada con asiento tapizado en blanco, junto a una mesa con flores" />
            <figcaption>Silla curvada con asiento retapizado</figcaption>
          </figure>
          <figure class="work work--tall">
            <Picture src={sillonesJardin} formats={formatos} alt="Par de sillones de caña restaurados" />
            <figcaption>Par de sillones de caña</figcaption>
          </figure>
          <figure class="work work--tall">
            <Picture src={esterilla} formats={formatos} alt="Rollo de esterilla tejida para asientos" />
            <figcaption>Esterilla para asientos y respaldos</figcaption>
          </figure>
        </div>

        <p class="more">Más trabajos en <a href={INSTAGRAM} target="_blank" rel="noopener">@tacuararte</a></p>
      </div>
    </section>

    <!-- ============ CESTERÍA ============ -->
    <section class="section wrap" id="cesteria">
      <header class="section__head section__head--split">
        <div>
          <p class="eyebrow">Cestería en mimbre · 100% artesanal</p>
          <h2>Canastos y canastas de mimbre, <em>modelos varios</em></h2>
          <p class="section__intro">Cada canasta se teje a mano en el taller. Trabajamos a pedido y de manera personalizada: tamaño, forma y combinación de colores a gusto.</p>
        </div>
        <a class="btn btn--ghost" href="https://drive.google.com/file/d/1vY4LDMsy3v-gLv5DBbeEwHE3gsnN9WWk/view" target="_blank" rel="noopener">Ver catálogo completo (PDF)</a>
      </header>

      <ul class="catalog" id="catalog">
        {catalogo.map(({ n, name, desc, foto, grande }) => (
          <li class="item reveal">
            <button class="item__pic" type="button" data-full={grande} data-cap={`Modelo ${n} · ${name}`} aria-label={`Ampliar foto del modelo ${n}`}>
              <Picture src={foto} formats={formatos} widths={[400, 800]} sizes="(max-width: 600px) 50vw, 280px" alt={`Modelo ${n}: ${name.toLowerCase()} de mimbre`} />
              <span class="item__num">{n}</span>
            </button>
            <div class="item__body">
              <h3>{name}</h3>
              <p>{desc}</p>
              <a class="item__ask" href={waLink(`Hola Carlos, me interesa la canasta modelo ${n} (${name}). ¿Me pasás precio y medidas?`)} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>Consultar
              </a>
            </div>
          </li>
        ))}
      </ul>

      <div class="custom">
        <div class="custom__pics">
          <Picture src={variedad1} formats={formatos} widths={[400, 800]} sizes="(max-width: 700px) 50vw, 320px" alt="Tres canastas ovaladas de distintos tamaños apiladas" />
          <Picture src={paneraTejidos} formats={formatos} widths={[400, 800]} sizes="(max-width: 700px) 50vw, 320px" alt="Panera de mimbre con tejidos de colores" />
        </div>
        <div class="custom__text">
          <p class="eyebrow">Trabajos personalizados</p>
          <h3>Variedad en tamaños y formas</h3>
          <p>¿Necesitás una canasta para un lugar puntual, un juego de paneras o un regalo? Contanos qué buscás y lo hacemos a medida.</p>
          <a class="btn btn--wa" href={waLink(MENSAJES.aMedida)} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
            Encargar a medida
          </a>
        </div>
      </div>
    </section>

    <!-- ============ CÓMO TRABAJAMOS ============ -->
    <section class="section section--sand" id="como-trabajamos">
      <div class="wrap">
        <header class="section__head">
          <p class="eyebrow">Paso a paso</p>
          <h2>Cómo <em>trabajamos</em></h2>
        </header>
        <ol class="steps">
          <li>
            <span class="steps__n">1</span>
            <h3>Mandanos fotos</h3>
            <p>Escribinos por WhatsApp con fotos del mueble o una idea de lo que querés encargar.</p>
          </li>
          <li>
            <span class="steps__n">2</span>
            <h3>Presupuesto</h3>
            <p>Te contamos qué trabajo necesita, con qué materiales y el precio.</p>
          </li>
          <li>
            <span class="steps__n">3</span>
            <h3>Manos a la obra</h3>
            <p>El trabajo se hace en el taller, a mano y sin apuro.</p>
          </li>
          <li>
            <span class="steps__n">4</span>
            <h3>Entrega</h3>
            <p>Coordinamos la entrega de tu mueble restaurado o tu pieza terminada.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ CONTACTO ============ -->
    <section class="section wrap" id="contacto">
      <div class="contact">
        <div class="contact__text">
          <p class="eyebrow">Contacto · Taller en Corrientes Capital</p>
          <h2>¿Tenés un mueble <em>esperando una segunda vida?</em></h2>
          <p>Escribinos y contanos qué necesitás. Atendemos consultas por WhatsApp e Instagram.</p>
          <dl class="contact__list">
            <div><dt>WhatsApp</dt><dd><a href={waLink()} target="_blank" rel="noopener">{WHATSAPP_VISIBLE}</a></dd></div>
            <div><dt>Instagram</dt><dd><a href={INSTAGRAM} target="_blank" rel="noopener">@tacuararte</a></dd></div>
            <div><dt>Taller</dt><dd>Corrientes Capital, Argentina</dd></div>
          </dl>
          <a class="btn btn--wa btn--lg" href={waLink(MENSAJES.consulta)} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
            Escribir por WhatsApp
          </a>
        </div>
        <figure class="contact__logo">
          <Picture src={logo} formats={formatos} alt="Logo de TacuarArte con las iniciales C y R sobre mimbre, arpillera y madera" />
          <figcaption>Carlos Roubineau · Artesano</figcaption>
        </figure>
      </div>
    </section>

  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <span class="brand brand--small"><span class="brand__mark">C<i></i>R</span><span class="brand__name">TacuarArte</span></span>
      <span>© <span id="year">{new Date().getFullYear()}</span> TacuarArte · Carlos Roubineau · Corrientes</span>
      <a href="#top">Volver arriba ↑</a>
    </div>
  </footer>

  <!-- Floating WhatsApp -->
  <a class="fab" href={waLink(MENSAJES.consulta)} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-wa"/></svg>
  </a>

  <!-- Lightbox -->
  <dialog class="lightbox" id="lightbox" aria-label="Foto ampliada">
    <button class="lightbox__close" id="lbClose" aria-label="Cerrar">×</button>
    <img id="lbImg" alt="">
    <p id="lbCap"></p>
  </dialog>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-wa" viewBox="0 0 24 24"><path fill="currentColor" d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5.1 5.24-1.37A9.9 9.9 0 1 0 12.04 2zm0 18.1a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.1.82.83-3.03-.2-.31a8.2 8.2 0 1 1 6.95 3.85zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.55.12-.17.25-.64.8-.78.96-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.66.31-.23.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.6.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.29z"/></symbol>
  </svg>

  <script is:inline src={`${base}js/main.js?v=2`}></script>
</body>
</html>
